<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{12228e0f-a5a3-4f5a-be0a-75fae71d01ff}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	XPlanarTable : FB_XPlanarModule;
	Initialize	 : BOOL; // Initialize the system
	Reset		 : BOOL; // Reset and Execute System
	Start		 : BOOL; // Run the system
	Halt		 : BOOL; // Avoid Disabling while spinning, otherwise physical sqauring of mover is required
	MachineState : (Startup,
		InitSystem,
		ResetSystem,
		Recover,
		Ready,
		Run,
		Disable);
	trig : R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//This project is an example that shows how you can build track segments using PLC logic
//The specific code for this is in the BuildTracks method of FB_XPlanarModule
//It is a working sample the builds the tracks during the Reset state, joins the mover to the track and runs 1 loop.


//Keep all XPlanar motion system objects up to date every cycle
XPlanarTable.CyclicLogic();


// "Machine" Sequence
CASE MachineState OF
	Startup:	
		IF Initialize THEN
			Initialize := FALSE;
			MachineState := InitSystem;
		END_IF
	
	InitSystem:	
		IF XPlanarTable.Initialize() THEN
			MachineState := ResetSystem;
		END_IF
	
	ResetSystem:	
		IF Reset AND_THEN XPlanarTable.Reset() THEN
			Reset := FALSE;
			MachineState := Recover;
		END_IF
	
	Recover:	
		IF XPlanarTable.Recovery() THEN
			MachineState := Ready;
		END_IF
		
	Ready:
		IF Start THEN
			MachineState := Run;
		END_IF
	
	Run: 
		XPlanarTable.Execute();
	
	Disable:	
		IF XPlanarTable.Disable() THEN
			MachineState := 0;
		END_IF
END_CASE

IF Halt OR trig.Q THEN
	MachineState := Disable;
	Halt := FALSE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>