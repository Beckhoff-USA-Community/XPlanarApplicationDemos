		<DataType>
			<Name GUID="{6D2B99B2-A9F2-44AF-A298-4BB7A08AE294}" Namespace="MC" TcBaseType="true">MC_PLANAR_STATE</Name>
			<Comment><![CDATA[Indicates the enable state of a component.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates no or invalid information, e.g. no connection or component not yet ready.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Disabled]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Indicates a disabled component.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Enabling]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Indicates an enabling component.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Enabled]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Indicates an enabled component.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Disabling]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Indicates a disabling component.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Error]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Indicates a component in error state.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ErrorPending]]></Text>
				<Enum>6</Enum>
				<Comment><![CDATA[Indicates that a component is transitioning from any non error state to the error state.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Resetting]]></Text>
				<Enum>7</Enum>
				<Comment><![CDATA[Indicates that a component is resetting after it was in error state.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{FAE6DCD6-33EF-4275-8592-10BCED19E1EA}" Namespace="MC">MC_PLANAR_MOVER_COMMAND_MODE</Name>
			<Comment><![CDATA[Indicates the command mode of an enabled PlanarMover, i.e. how setpoints are currently produced.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates no or invalid information, e.g. no connection or component not yet ready.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[FreeMovement]]></Text>
				<Enum>101</Enum>
				<Comment><![CDATA[Indicates a freely moving PlanarMover.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[OnTrack]]></Text>
				<Enum>102</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is moving on a PlanarTrack.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[JoiningTrack]]></Text>
				<Enum>103</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is approaching a PlanarTrack to join it.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[LeavingTrack]]></Text>
				<Enum>104</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is leaving a PlanarTrack to move freely afterwards.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ExternalSetpointGeneration]]></Text>
				<Enum>105</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is following externally provided setpoints.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[CRotationFreeMovement]]></Text>
				<Enum>106</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is only rotating the C coordinate in free movement, X and Y are standing.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[CRotationOnTrack]]></Text>
				<Enum>107</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is only rotating the C coordinate on a track, X and Y are standing.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ExternalBodeplot]]></Text>
				<Enum>109</Enum>
				<Comment><![CDATA[Indicates that the PlanarMover is following external bodeplot setpoints.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{DB4B14FF-1923-4ED2-A97C-3D3120BDBDAA}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_PLANAR_MOVER_TRACK</Name>
			<Comment><![CDATA[CDT provides the current mover setpoint on the planar track (if mover is on track).]]></Comment>
			<BitSize>320</BitSize>
			<SubItem>
				<Name>SetPos</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current position.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>SetVelo</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current velocity.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>SetAcc</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current acceleration.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>SetJerk</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current jerk.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
			<SubItem>
				<Name>TrackOID</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</Type>
				<Comment><![CDATA[Current track object id.]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>256</BitOffs>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{C4BA2B11-27FE-4956-B736-B8F79E7E1624}" Namespace="MC" TcBaseType="true">MC_EXTERNAL_SET_POSITION_MODE</Name>
			<Comment><![CDATA[Indicates the external setpoint generation mode.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates invalid data.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Absolute]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Indicates that the Planar Mover is following only the external setpoints.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Relative]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Indicates that internal setpoint generation continues normally and the externally provided setpoints are added as an offset.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Indicates no external setpoint generation.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{3192C90B-2605-4DD5-87BE-005A80B3990B}" Namespace="MC">PlanarTrackOTCID</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</BaseType>
			<Properties>
				<Property>
					<Name>OTCID</Name>
				</Property>
				<Property>
					<Name>TcCategoryOID</Name>
					<Value>McPlanarTrack</Value>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{29613389-89D4-4541-B76E-D16742890DEF}" Namespace="MC">MC_TRACK_POSITION</Name>
			<BitSize>128</BitSize>
			<SubItem>
				<Name>Position</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<BitSize>64</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>TrackOid</Name>
				<Type GUID="{3192C90B-2605-4DD5-87BE-005A80B3990B}" Namespace="MC">PlanarTrackOTCID</Type>
				<BitSize>32</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{50FEC5F2-C9A2-49A2-AB32-4764BBA0A649}" Namespace="MC" TcBaseType="true">MC_GAP_MODE_ON_TRACK</Name>
			<Comment><![CDATA[Indicates the way in which gap control is done on track.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates no or invalid information, e.g. no connection or component not yet ready.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Standard1D]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The Planar Mover keeps a distance to its neighbors on track that is at least the sum of gap and stop distance.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Fast1D]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[The Planar Mover keeps a distance to its neighbors on track that is at least the gap.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{51EC8EBA-E260-4EDC-94C0-5ED02ABD2F9A}" Namespace="MC" TcBaseType="true">MC_DYNAMICS_REDUCTION_MODE</Name>
			<Comment><![CDATA[Indicates the way in which dynamics are planned when moving on track.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates no or invalid information, e.g. no connection or component not yet ready.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The Planar Mover interprets the given dynamic limits in a one-dimensional fashion, with respect to the track's arclength. This way, the maximum velocity is aimed at even in curves.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[AccelerationLimitedVelocity]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[The maximal velocity in curves is reduced to not exceed the maximum x,y radial acceleration there. Produces the same behavior as the None mode when on a straight track.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{814ADC69-F405-4E98-AE53-901793DD7E72}" Namespace="MC" TcBaseType="true">MC_MOVEMENT_TYPE_ON_TRACK</Name>
			<Comment><![CDATA[Type of a movement on track, e.g. Standstill.]]></Comment>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Indicates no or invalid information, e.g. mover is not on track.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Standstill]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Mover does not move.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MoveOnTrack]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Mover moves to a specific target position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MoveOnTrackVelocity]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Mover moves with a specific target velocity.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[GearInPosOnTrack]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Mover tries to follow a master reference (e.g. another Mover).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Halt]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Mover tries to end the current movement as fast as possible.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
		</DataType>
		<DataType>
			<Name GUID="{245D0CA9-641C-4E63-AAB6-519FF2022292}" Namespace="MC" TcBaseType="true">MC_MOVER_ON_TRACK_INFORMATION</Name>
			<Comment><![CDATA[Information about a mover on track (target position, gap, etc.).]]></Comment>
			<BitSize>576</BitSize>
			<SubItem>
				<Name>TargetPosition</Name>
				<Type GUID="{29613389-89D4-4541-B76E-D16742890DEF}" Namespace="MC">MC_TRACK_POSITION</Type>
				<Comment><![CDATA[Target position of the mover, zero if not busy with move on track.]]></Comment>
				<BitSize>128</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>RemainingDistance</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Distance the mover will travel to its target position.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Gap</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Gap that the mover keeps to its neighbors.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Limits</Name>
				<Type GUID="{38ED262D-F8F3-4BB3-9E0F-BFC46C6E916B}" Namespace="MC">DynamicLimits1D</Type>
				<Comment><![CDATA[Dynamic limits the mover does not violate.]]></Comment>
				<BitSize>256</BitSize>
				<BitOffs>256</BitOffs>
			</SubItem>
			<SubItem>
				<Name>GapMode</Name>
				<Type GUID="{50FEC5F2-C9A2-49A2-AB32-4764BBA0A649}" Namespace="MC">MC_GAP_MODE_ON_TRACK</Type>
				<Comment><![CDATA[Indicates the way in which gap control is done on track.]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>512</BitOffs>
			</SubItem>
			<SubItem>
				<Name>DynamicMode</Name>
				<Type GUID="{51EC8EBA-E260-4EDC-94C0-5ED02ABD2F9A}" Namespace="MC">MC_DYNAMICS_REDUCTION_MODE</Type>
				<Comment><![CDATA[Indicates the way in which dynamic limits are interpreted.]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>528</BitOffs>
			</SubItem>
			<SubItem>
				<Name>MovementType</Name>
				<Type GUID="{814ADC69-F405-4E98-AE53-901793DD7E72}" Namespace="MC">MC_MOVEMENT_TYPE_ON_TRACK</Type>
				<Comment><![CDATA[Indicates which type of movement is executed (MoveOnTrack, Halt, etc.).]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>544</BitOffs>
			</SubItem>
			<SubItem>
				<Name>IsAvoidingCollision</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Indicates if the mover is deviating from its intended movement because of another mover.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>560</BitOffs>
			</SubItem>
